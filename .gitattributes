# Unix line endings in the working tree on every OS: the scripts run on the head unit
* text=auto eol=lf
*.cmd text eol=crlf
*.png binary
*.gif binary
*.mgu binary
kit/renderd/prebuilt/mgu-renderd binary
*.pack binary

# PERFORMANCE art stays in GitHub but is fetched and checksum-verified during the Store build.
apps/performance/assets/** export-ignore
apps/performance/designs/**/*.png export-ignore
