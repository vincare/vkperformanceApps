{
  "id": "performance",
  "title": "PERFORMANCE",
  "description": "Live engine monitor, road-estimate dyno, and guarded BMW exhaust-flap controls",
  "version": "0.6.6",
  "loggingId": "OAA6",
  "iconGlyph": "dyno",
  "mguHmi": ["ID7"],
  "requires": { "idrive7-renderd": "2.1.18", "mgu-inputgate": "1.1.0" },
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle": {
      "_optional": "display pressure units used by the Sport Display boost signal",
      "statusNewCurrentUnitsStatusExt": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "statusLongitudinalAccelerationMassCenter": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusActualValueTorque2": "rs",
      "statusVehicleDynamicEngine": "rs",
      "statusSwitchDriveDynamicSport2": "rs",
      "statusFESVehicleDynamicSwitchHMI": "rs"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": ["sendTasuRequest"],
      "_broadcasts": ["sendTasuResponse"]
    }
  },
  "settings": [
    {
      "key": "valveControl",
      "label": "Exhaust valve control",
      "type": "choice",
      "default": "off",
      "options": [
        ["off", "Disarmed · no car commands"],
        ["on", "Armed · sends commands to a matched DME"]
      ]
    },
    {
      "key": "valveHold",
      "label": "Hold exhaust valve request",
      "type": "choice",
      "default": "off",
      "options": [
        ["off", "Off · do not repeat commands"],
        ["on", "On · resend every 15 seconds"]
      ]
    },
    {
      "key": "valveCloseLimit",
      "label": "Close: return to BMW above",
      "type": "choice",
      "default": "4000",
      "options": [
        ["2500", "2,500 rpm"],
        ["3000", "3,000 rpm"],
        ["3500", "3,500 rpm"],
        ["4000", "4,000 rpm"],
        ["4500", "4,500 rpm"],
        ["5000", "5,000 rpm"],
        ["5500", "5,500 rpm"],
        ["off", "No RPM limit · not recommended"]
      ]
    },
    {
      "key": "performanceDiagnostics",
      "label": "Performance diagnostics (raw)",
      "type": "bool",
      "default": true
    },
    {
      "key": "readDmeCandidates",
      "label": "Read DME candidates (read-only)",
      "type": "bool",
      "default": true
    },
    {
      "key": "powerSource",
      "label": "Power from",
      "type": "choice",
      "default": "sport",
      "options": [
        ["sport", "Sport Display"],
        ["calc", "Torque x RPM"]
      ]
    },
    {
      "key": "powerUnit",
      "label": "Power unit",
      "type": "choice",
      "default": "hp",
      "options": [
        ["kw", "kW"],
        ["hp", "hp"],
        ["ps", "PS"]
      ]
    },
    {
      "key": "maxPower",
      "label": "Max power (100% on Sport Display)",
      "type": "number",
      "unit": "kW",
      "unitBy": "powerUnit",
      "units": {
        "hp": {"unit": "hp", "mul": 1.34102},
        "ps": {"unit": "PS", "mul": 1.35962}
      },
      "default": 215,
      "steps": [100, 120, 135, 140, 150, 160, 170, 185, 190, 200, 215, 230, 240, 250, 260, 275, 285, 300, 320, 340, 360, 375, 390, 405, 420, 450, 460, 480, 500, 530, 550, 600]
    },
    {
      "key": "powerGaugeMax",
      "label": "HORSE POWER scale max",
      "type": "number",
      "unit": "kW",
      "unitBy": "powerUnit",
      "units": {
        "hp": {"unit": "hp", "mul": 1.34102},
        "ps": {"unit": "PS", "mul": 1.35962}
      },
      "default": 223.7,
      "steps": [149.1, 186.4, 223.7, 261.0, 298.3, 335.6, 372.9, 447.4, 522.0, 596.6, 671.1, 745.7]
    },
    {
      "key": "torqueGaugeMax",
      "label": "TORQUE scale max",
      "type": "number",
      "unit": "Nm",
      "default": 800,
      "steps": [300, 400, 500, 600, 700, 800, 900, 1000, 1200, 1400, 1600]
    },
    {
      "key": "dynoWeight",
      "label": "Dyno vehicle weight with driver + fuel",
      "type": "number",
      "unit": "kg",
      "default": 1750,
      "steps": [1300, 1400, 1500, 1550, 1600, 1650, 1700, 1750, 1800, 1850, 1900, 1950, 2000, 2100, 2200, 2300, 2400, 2500, 2600, 2700, 2800, 2900, 3000, 3100, 3200, 3300, 3400, 3500]
    },
    {
      "key": "dynoBody",
      "label": "Dyno body shape (air drag)",
      "type": "choice",
      "default": "coupe",
      "options": [
        ["coupe", "Coupe / sedan"],
        ["wagon", "Touring / hatch"],
        ["suv", "SUV"]
      ]
    },
    {
      "key": "dynoLoss",
      "label": "Dyno drivetrain loss",
      "type": "number",
      "unit": "%",
      "default": 15,
      "steps": [0, 10, 12, 15, 18, 20, 25]
    },
    {
      "key": "boostSource",
      "label": "Boost from",
      "type": "choice",
      "default": "auto",
      "options": [
        ["auto", "Auto (Sport Display, then DME)"],
        ["fes", "Sport Display"],
        ["dme", "Engine unit (OBD)"]
      ]
    },
    {
      "key": "demo",
      "label": "Demo data",
      "type": "choice",
      "default": "off",
      "options": [
        ["off", "Never"],
        ["on", "Always"]
      ]
    },
    {
      "key": "carModel",
      "label": "Car Model",
      "type": "choice",
      "default": "M340i_Blue",
      "options": [
        ["M340i_Blue", "M340i G20 BLUE"],
        ["M340i_Red", "M340i G20 RED"],
        ["M340i_Black", "M340i G20 BLACK"],
        ["M440i_Blue", "M440i G22 BLUE"],
        ["M440i_Red", "M440i G22 RED"],
        ["M440i_Black", "M440i G22 BLACK"]
      ]
    },
    {
      "key": "theme",
      "label": "Colour theme",
      "type": "choice",
      "default": "m_red",
      "options": [
        ["m_red", "M Red"],
        ["m_tricolour", "M Tricolour"]
      ]
    }
  ],
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Engine Data",
      "buttons": [
        ["BTN_OPEN", "Open valves"],
        ["BTN_CLOSE", "Close valves"],
        ["BTN_OEM", "OEM control"],
        ["BTN_DRIVE", "By drive mode"],
        ["BTN_PAGE", "Next page"],
        ["BTN_PREV", "Previous page"],
        ["BTN_SECTION", "Open exhaust section"],
        ["BTN_SECTION_BACK", "Back to systems"],
        ["BTN_SETTINGS", "Settings"]
      ]
    }
  ],
  "config": {
    "comment": "The RPM, torque, Sport Display percentage, FES boost and DME boost candidates use the same conversions and candidate order as M Vitals (MIT).",
    "scaling": {
      "rpm": {"factor": 0.25, "offset": 0, "invalid": 65535},
      "speed": {"factor": 0.015625, "offset": 0, "invalid": 65535},
      "accel": {"factor": 0.002, "offset": -65, "invalid": 65535},
      "torque": {"factor": 0.5, "offset": -1023.5, "invalid": 65535, "invalidFrom": 4095},
      "sportPct": {"factor": 1, "offset": 0, "invalid": 255},
      "boost": {"factor": 0.01, "offset": 0, "invalid": 255}
    },
    "dme": {
      "ecu": 18,
      "boost": [
        {"did": "F470", "bytes": 2, "at": 3, "factor": 0.03125, "min": 20, "max": 600, "note": "M Vitals OBD PID 0x70 actual absolute pressure, 1/32 kPa"},
        {"did": "F487", "bytes": 2, "at": 1, "factor": 0.03125, "min": 20, "max": 600, "note": "M Vitals OBD PID 0x87 manifold absolute pressure, 1/32 kPa"},
        {"did": "F40B", "bytes": 1, "at": 0, "factor": 1, "min": 20, "max": 255, "note": "M Vitals OBD PID 0x0B manifold absolute pressure, kPa"},
        {"obd": "0B", "bytes": 1, "at": 0, "factor": 1, "min": 20, "max": 255, "note": "M Vitals OBD service 01 PID 0x0B"}
      ],
      "baro": [
        {"did": "F433", "bytes": 1, "at": 0, "factor": 1, "min": 50, "max": 115, "note": "M Vitals OBD PID 0x33 barometric pressure, kPa"},
        {"obd": "33", "bytes": 1, "at": 0, "factor": 1, "min": 50, "max": 115, "note": "M Vitals OBD service 01 PID 0x33 barometric pressure"}
      ]
    }
  }
}
