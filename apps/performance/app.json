{
  "id": "performance",
  "title": "PERFORMANCE",
  "description": "Live engine monitor, ENGINE CONFIG with exhaust and ROM-gated BM3 burble controls, DYNO RUN estimates, and DRAG RUN timers",
  "version": "0.6.34",
  "maxDiskUsage": 33554432,
  "loggingId": "OAA6",
  "iconGlyph": "dyno",
  "mguHmi": [
    "ID7"
  ],
  "requires": {
    "idrive7-renderd": "2.1.18",
    "mgu-inputgate": "1.1.0"
  },
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs",
      "statusEngineStatus": "rs",
      "statusBattery2": "rs",
      "statusHandBrake": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle": {
      "_optional": "display pressure units used by the Sport Display boost signal",
      "statusNewCurrentUnitsStatusExt": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs",
      "statusOilDipstick2": "rs",
      "statusVehicleMass": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "statusLongitudinalAccelerationMassCenter": "rs",
      "statusPushButtonMSA2": "rs"
    },
    "de.bmw.infrastructure.analytics.BasicDataSet": {
      "_optional": "EGS oil temperature and xDrive torque split used by CAR DATA",
      "basicDataSet": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusActualValueTorque2": "rs",
      "statusVehicleDynamicEngine": "rs",
      "statusSwitchDriveDynamicSport2": "rs",
      "statusFESVehicleDynamicSwitchHMI": "rs"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s"
    },
    "de.bmw.infotainment.KombiIF": {
      "statusRangeTankStatus": "rs",
      "statusBordcomputerAverage": "rs"
    },
    "de.bmw.powertrain.AcceleratorPedal": {
      "AngleAcceleratorPedal": "s"
    },
    "de.bmw.infotainment.vehicle.TPMS": {
      "statusTyrePressure": "rs",
      "statusTyreTemperature": "rs",
      "statusTargetTyrePressure": "rs"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    }
  },
  "settings": [
    {
      "key": "valveControl",
      "label": "Car exhaust control",
      "desc": "Off by default. Turn on to allow the matched DME controls to send valve commands after you select a control in the app.",
      "type": "choice",
      "default": "off",
      "reset": 2,
      "options": [
        [
          "off",
          "Disarmed · no car commands"
        ],
        [
          "on",
          "Armed · sends commands to a matched DME"
        ]
      ]
    },
    {
      "key": "driveLink",
      "label": "Drive Mode exhaust follow",
      "type": "choice",
      "default": "off",
      "hidden": true,
      "reset": 1,
      "options": [
        [
          "off",
          "Off"
        ],
        [
          "on",
          "On"
        ]
      ]
    },
    {
      "key": "sec_exhaust",
      "label": "EXHAUST",
      "type": "section"
    },
    {
      "key": "valveHold",
      "label": "Hold exhaust valve request",
      "desc": "Repeats the last OPEN / CLOSED / OEM valve command every 15 seconds so the flaps cannot quietly revert to the drive mode.",
      "type": "choice",
      "default": "off",
      "options": [
        [
          "off",
          "Off · do not repeat commands"
        ],
        [
          "on",
          "On · resend every 15 seconds"
        ]
      ]
    },
    {
      "key": "performanceDiagnostics",
      "label": "Raw diagnostics (troubleshooting)",
      "type": "bool",
      "default": false,
      "hidden": true
    },
    {
      "key": "readDmeCandidates",
      "label": "Read DME candidates (read-only)",
      "type": "bool",
      "default": true,
      "hidden": true
    },
    {
      "key": "powerSource",
      "label": "Engine power estimate from",
      "desc": "Sport Display power is a percentage scaled by Max engine power. Torque × RPM is also an estimate.",
      "type": "choice",
      "default": "sport",
      "options": [
        [
          "sport",
          "Sport Display"
        ],
        [
          "calc",
          "Torque x RPM"
        ]
      ]
    },
    {
      "key": "sec_gauges",
      "label": "GAUGES & DISPLAY",
      "type": "section"
    },
