      "unit": "%",
      "default": 15,
      "steps": [
        0,
        10,
        12,
        15,
        18,
        20,
        25
      ]
    },
    {
      "key": "dynoTorqueUnit",
      "label": "Dyno torque unit",
      "desc": "The unit torque is drawn in on the dyno curve and in the saved runs.",
      "type": "choice",
      "default": "nm",
      "options": [
        [
          "nm",
          "Nm"
        ],
        [
          "lbft",
          "lb-ft"
        ],
        [
          "kgm",
          "kgm"
        ]
      ]
    },
    {
      "key": "dynoEcuTorque",
      "label": "Overlay ECU torque on DYNO graph",
