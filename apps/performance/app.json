      "unit": "rpm",
      "default": 0,
      "labels": {
        "0": "Auto"
      },
      "reset": 1,
      "steps": [
        0,
        4500,
        5000,
        5500,
        6000,
        6500,
        7000,
        7500,
        8000,
        9000
      ]
    },
    {
      "key": "dragSpeedUnit",
      "label": "DRAG RUN speed unit",
      "desc": "km/h or mph for every drag split and trap speed — changes the section names too (100-200 becomes 60-130).",
