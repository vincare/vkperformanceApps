        3000,
        3100,
        3200,
        3300,
        3400,
        3500
      ]
    },
    {
      "key": "dynoBody",
      "label": "Dyno body shape (air drag)",
      "desc": "Your car's body shape — it sets the aerodynamic drag the dyno estimate subtracts at high speed.",
