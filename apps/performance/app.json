      "default": "kmh",
      "options": [
        [
          "kmh",
          "km/h"
        ],
        [
          "mph",
          "mph"
        ]
      ]
    },
    {
      "key": "dragDistance",
      "label": "DRAG RUN distance split",
      "desc": "The standing-distance split the timer measures — quarter mile, eighth mile or 1000 m.",
