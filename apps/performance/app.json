  "settings": [
    {
      "key": "valveControl",
      "label": "Car exhaust control",
      "desc": "Off by default. Turn on to allow the matched DME controls to send valve commands after you select a control in the app.",
      "type": "choice",
      "default": "off",
      "reset": 2,
      "options": [
        [
          "off",
          "Disarmed · no car commands"
        ],
        [
          "on",
          "Armed · sends commands to a matched DME"
        ]
      ]
    },
    {
      "key": "driveLink",
      "label": "Drive Mode exhaust follow",
      "type": "choice",
      "default": "off",
      "hidden": true,
      "reset": 1,
      "options": [
        [
          "off",
          "Off"
        ],
        [
          "on",
          "On"
        ]
      ]
    },
    {
      "key": "sec_exhaust",
      "label": "EXHAUST",
      "type": "section"
    },
    {
      "key": "valveHold",
      "label": "Hold exhaust valve request",
      "desc": "Repeats the last OPEN / CLOSED / OEM valve command every 15 seconds so the flaps cannot quietly revert to the drive mode.",
      "type": "choice",
      "default": "off",
      "options": [
        [
          "off",
          "Off · do not repeat commands"
        ],
        [
          "on",
          "On · resend every 15 seconds"
        ]
      ]
    },
    {
      "key": "performanceDiagnostics",
      "label": "Raw diagnostics (troubleshooting)",
      "type": "bool",
      "default": false,
      "hidden": true
    },
    {
      "key": "readDmeCandidates",
      "label": "Read DME candidates (read-only)",
      "type": "bool",
      "default": true,
      "hidden": true
    },
    {
      "key": "powerSource",
      "label": "Engine power estimate from",
      "desc": "Sport Display power is a percentage scaled by Max engine power. Torque × RPM is also an estimate.",
      "type": "choice",
      "default": "sport",
      "options": [
        [
          "sport",
          "Sport Display"
        ],
        [
          "calc",
          "Torque x RPM"
        ]
      ]
    },
    {
      "key": "sec_gauges",
      "label": "GAUGES & DISPLAY",
      "type": "section"
    },
    {
      "key": "powerUnit",
      "label": "Power unit",
      "desc": "The unit every power figure is shown in — engine data, dyno results and saved runs.",
      "type": "choice",
      "default": "hp",
      "options": [
        [
          "kw",
          "kW"
        ],
        [
          "hp",
          "hp"
        ],
        [
          "ps",
          "PS"
        ]
      ]
    },
    {
      "key": "maxPower",
      "label": "Max engine power (100% on Sport Display)",
      "desc": "The Sport Display reports a percentage, not horsepower. Set this to your verified engine output to calibrate the live estimate.",
      "type": "number",
